{
  "name": "minime-chat-promo",
  "version": "0.1.0",
  "private": true,
  "description": "MiniMe Chat-tab promo video, built with Remotion",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "assets": "node scripts/fetch-assets.mjs",
    "sfx": "node scripts/make-sfx.mjs",
    "mix": "node scripts/mix-audio.mjs",
    "check": "node scripts/check-stills.mjs",
    "render": "node scripts/render.mjs",
    "render:4k": "node scripts/render.mjs --4k",
    "render:frames": "node scripts/render.mjs --frames",
    "render:all": "node scripts/render.mjs --all",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.539",
    "@remotion/google-fonts": "4.0.539",
    "lucide-react": "^1.64.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.539"
  },
  "devDependencies": {
    "@types/react": "^18.3.30",
    "typescript": "~5.9.3"
  }
}
